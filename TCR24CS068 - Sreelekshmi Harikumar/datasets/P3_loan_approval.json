{
 "problem_id": "P3_loan_approval",
 "domain": "banking / loan processing",
 "description": "From an application to a signed and disbursed loan with a decision e-mail.",
 "state_variables": [
  {
   "name": "App.submitted",
   "type": "bool"
  },
  {
   "name": "Docs.uploaded",
   "type": "bool"
  },
  {
