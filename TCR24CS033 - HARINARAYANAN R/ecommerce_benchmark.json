{
  "name": "ECommerce_OrderFulfillment",
  "description": "Canonical e-commerce capability composition domain with purchasing pipeline and distractors.",
  "state_variables": [
    {
      "name": "User.authenticated",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    },
    {
      "name": "User.role",
      "var_type": "ENUM",
      "domain": [
        "CUSTOMER",
        "ADMIN",
        "GUEST"
      ],
      "default_value": "CUSTOMER",
      "description": ""
    },
    {
      "name": "Cart.exists",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    },
    {
      "name": "Cart.item_count",
      "var_type": "INTEGER",
      "domain": null,
      "default_value": 0,
      "description": ""
    },
    {
      "name": "Cart.locked",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    },
    {
      "name": "Order.exists",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    },
    {
      "name": "Order.status",
      "var_type": "ENUM",
      "domain": [
        "NONE",
        "CREATED",
        "PENDING",
        "PAID",
        "CANCELLED",
        "SHIPPED"
      ],
      "default_value": "NONE",
      "description": ""
    },
    {
      "name": "Payment.status",
      "var_type": "ENUM",
      "domain": [
        "NOT_STARTED",
        "PROCESSING",
        "SUCCESS",
        "FAILED"
      ],
      "default_value": "NOT_STARTED",
      "description": ""
    },
    {
      "name": "Inventory.available",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": true,
      "description": ""
    },
    {
      "name": "Notification.sent",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    },
    {
      "name": "Discount.applied",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    },
    {
      "name": "Telemetry.processed",
      "var_type": "BOOLEAN",
      "domain": null,
      "default_value": false,
      "description": ""
    }
  ],
  "initial_state": {
    "name": "InitialState_S_I",
    "values": {
      "User.authenticated": true,
      "User.role": "CUSTOMER",
      "Cart.exists": true,
      "Cart.item_count": 3,
      "Cart.locked": false,
      "Order.exists": false,
      "Order.status": "NONE",
      "Payment.status": "NOT_STARTED",
      "Inventory.available": true,
      "Notification.sent": false,
      "Discount.applied": false,
      "Telemetry.processed": false
    }
  },
  "goal": {
    "name": "Goal_PurchaseAndNotify",
    "conditions": [
      {
        "variable": "Order.exists",
        "target_value": true,
        "op": "==",
        "weight": 1.0
      },
      {
        "variable": "Payment.status",
        "target_value": "SUCCESS",
        "op": "==",
        "weight": 1.0
      },
      {
        "variable": "Notification.sent",
        "target_value": true,
        "op": "==",
        "weight": 1.0
      }
    ]
  },
  "available_resources": [
    "Database",
    "Network",
    "PaymentGateway",
    "AuthToken",
    "EmailService",
    "FileSystem",
    "ExternalService"
  ],
  "global_constraints": [
    {
      "name": "RoleCheck",
      "expression": "User.role in {CUSTOMER, ADMIN}",
      "constraint_type": "SECURITY"
    }
  ],
  "capabilities": [
    {
      "id": "C1_CreateOrder",
      "name": "CreateOrder",
      "type": "API",
      "inputs": [
        {
          "name": "cart_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        },
        {
          "name": "user_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "order_id",
          "data_type": "UUID",
          "domain": "valid UUIDs"
        },
        {
          "name": "total_amount",
          "data_type": "FLOAT",
          "domain": "positive decimals"
        }
      ],
      "preconditions": [
        {
          "variable": "Cart.exists",
          "expected_value": true,
          "op": "=="
        },
        {
          "variable": "Inventory.available",
          "expected_value": true,
          "op": "=="
        }
      ],
      "effects": [
        {
          "variable": "Order.exists",
          "new_value": true,
          "action": "SET"
        },
        {
          "variable": "Order.status",
          "new_value": "CREATED",
          "action": "SET"
        },
        {
          "variable": "Cart.locked",
          "new_value": true,
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "Database",
        "Network"
      ],
      "quality": {
        "time_ms": 100.0,
        "resource_cost": 2.0,
        "monetary_cost": 0.01,
        "risk": 0.02,
        "energy_cost": 0.01
      },
      "reliability": 0.99,
      "availability": 1.0,
      "mechanism": {
        "mechanism_type": "HTTP_REST",
        "details": {
          "method": "POST",
          "endpoint": "/orders"
        }
      },
      "description": "Creates an order record from an active shopping cart.",
      "sub_capabilities": []
    },
    {
      "id": "C2_MakePayment",
      "name": "MakePayment",
      "type": "SERVICE",
      "inputs": [
        {
          "name": "order_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        },
        {
          "name": "total_amount",
          "data_type": "FLOAT",
          "domain": "positive decimals",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "receipt_id",
          "data_type": "UUID",
          "domain": "valid UUIDs"
        },
        {
          "name": "payment_token",
          "data_type": "STRING",
          "domain": "alphanumeric token"
        }
      ],
      "preconditions": [
        {
          "variable": "Order.exists",
          "expected_value": true,
          "op": "=="
        },
        {
          "variable": "Order.status",
          "expected_value": "CREATED",
          "op": "=="
        }
      ],
      "effects": [
        {
          "variable": "Payment.status",
          "new_value": "SUCCESS",
          "action": "SET"
        },
        {
          "variable": "Order.status",
          "new_value": "PAID",
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "PaymentGateway",
        "Network",
        "AuthToken"
      ],
      "quality": {
        "time_ms": 250.0,
        "resource_cost": 3.0,
        "monetary_cost": 0.05,
        "risk": 0.04,
        "energy_cost": 0.02
      },
      "reliability": 0.98,
      "availability": 0.999,
      "mechanism": {
        "mechanism_type": "EXTERNAL_SERVICE",
        "details": {
          "provider": "StripeGateway",
          "action": "charge"
        }
      },
      "description": "Executes payment transaction for created order.",
      "sub_capabilities": []
    },
    {
      "id": "C3_CancelCart",
      "name": "CancelCart",
      "type": "API",
      "inputs": [
        {
          "name": "cart_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "cancellation_ref",
          "data_type": "STRING",
          "domain": "alphanumeric"
        }
      ],
      "preconditions": [
        {
          "variable": "Order.exists",
          "expected_value": false,
          "op": "=="
        },
        {
          "variable": "Cart.exists",
          "expected_value": true,
          "op": "=="
        }
      ],
      "effects": [
        {
          "variable": "Cart.exists",
          "new_value": false,
          "action": "SET"
        },
        {
          "variable": "Cart.item_count",
          "new_value": 0,
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "Database",
        "Network"
      ],
      "quality": {
        "time_ms": 60.0,
        "resource_cost": 1.0,
        "monetary_cost": 0.005,
        "risk": 0.01,
        "energy_cost": 0.005
      },
      "reliability": 0.995,
      "availability": 1.0,
      "mechanism": {
        "mechanism_type": "HTTP_REST",
        "details": {
          "method": "DELETE",
          "endpoint": "/cart"
        }
      },
      "description": "Cancels the active shopping cart before any order is placed.",
      "sub_capabilities": []
    },
    {
      "id": "C4_SendNotification",
      "name": "SendNotification",
      "type": "EVENT",
      "inputs": [
        {
          "name": "receipt_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        },
        {
          "name": "order_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "message_id",
          "data_type": "STRING",
          "domain": "dispatch ID"
        }
      ],
      "preconditions": [
        {
          "variable": "Payment.status",
          "expected_value": "SUCCESS",
          "op": "=="
        }
      ],
      "effects": [
        {
          "variable": "Notification.sent",
          "new_value": true,
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "EmailService",
        "Network"
      ],
      "quality": {
        "time_ms": 80.0,
        "resource_cost": 1.0,
        "monetary_cost": 0.002,
        "risk": 0.01,
        "energy_cost": 0.005
      },
      "reliability": 0.99,
      "availability": 1.0,
      "mechanism": {
        "mechanism_type": "EVENT_DISPATCH",
        "details": {
          "trigger": "OrderPaid",
          "handler": "SendEmail"
        }
      },
      "description": "Sends order confirmation receipt notification to customer.",
      "sub_capabilities": []
    },
    {
      "id": "C5_ApplyDiscount",
      "name": "ApplyDiscount",
      "type": "FUNCTION",
      "inputs": [
        {
          "name": "coupon_code",
          "data_type": "STRING",
          "domain": "valid code",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "discount_pct",
          "data_type": "FLOAT",
          "domain": "0.0-1.0"
        }
      ],
      "preconditions": [
        {
          "variable": "Cart.exists",
          "expected_value": true,
          "op": "=="
        },
        {
          "variable": "Cart.locked",
          "expected_value": false,
          "op": "=="
        }
      ],
      "effects": [
        {
          "variable": "Discount.applied",
          "new_value": true,
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "Database"
      ],
      "quality": {
        "time_ms": 25.0,
        "resource_cost": 0.5,
        "monetary_cost": 0.001,
        "risk": 0.005,
        "energy_cost": 0.001
      },
      "reliability": 0.999,
      "availability": 1.0,
      "mechanism": {
        "mechanism_type": "LOCAL_FUNC",
        "details": {
          "module": "pricing",
          "function": "apply_coupon"
        }
      },
      "description": "Applies promotional discount coupon to unlocked shopping cart.",
      "sub_capabilities": []
    },
    {
