      "name": "ExportAuditLog",
      "type": "FILE",
      "inputs": [
        {
          "name": "start_date",
          "data_type": "STRING",
          "domain": "YYYY-MM-DD",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "audit_csv",
          "data_type": "FILE",
          "domain": "CSV export"
        }
      ],
      "preconditions": [
        {
          "variable": "User.role",
          "expected_value": "ADMIN",
          "op": "=="
        }
      ],
      "effects": [
        {
          "variable": "Telemetry.processed",
          "new_value": true,
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "FileSystem",
        "Database"
      ],
      "quality": {
        "time_ms": 450.0,
        "resource_cost": 5.0,
        "monetary_cost": 0.02,
        "risk": 0.01,
        "energy_cost": 0.04
      },
      "reliability": 0.97,
      "availability": 0.99,
      "mechanism": {
        "mechanism_type": "FILE_IO",
        "details": {
          "path": "/var/log/audit.csv",
          "format": "CSV"
        }
      },
      "description": "Exports administrative system audit logs (irrelevant to customer purchase).",
      "sub_capabilities": []
    },
    {
