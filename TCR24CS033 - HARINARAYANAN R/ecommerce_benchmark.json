      "preconditions": [],
      "effects": [
        {
          "variable": "Telemetry.processed",
          "new_value": true,
          "action": "SET"
        }
      ],
      "constraints": [],
      "resources": [
        "Network",
        "ExternalService"
      ],
      "quality": {
        "time_ms": 300.0,
        "resource_cost": 1.5,
        "monetary_cost": 0.01,
        "risk": 0.02,
        "energy_cost": 0.02
      },
      "reliability": 0.95,
      "availability": 0.98,
      "mechanism": {
        "mechanism_type": "EXTERNAL_API",
        "details": {
          "endpoint": "https://weather.service/forecast"
