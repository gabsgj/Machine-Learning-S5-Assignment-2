{
  "name": "ECommerceOrderProcessingApp",
  "state_space_schema": {
    "User.authenticated": {
      "type": "bool",
      "default": true
    },
    "User.role": {
      "type": "enum",
      "values": [
        "GUEST",
        "CUSTOMER",
        "ADMIN"
      ],
      "default": "CUSTOMER"
    },
    "Cart.exists": {
      "type": "bool",
      "default": true
    },
    "Cart.item_count": {
      "type": "int",
      "default": 3
    },
    "Cart.locked": {
      "type": "bool",
      "default": false
    },
    "Order.exists": {
      "type": "bool",
      "default": false
    },
    "Order.status": {
      "type": "enum",
      "values": [
        "NONE",
        "CREATED",
        "PAID",
        "FULFILLED",
        "CANCELLED"
      ],
      "default": "NONE"
    },
    "Payment.status": {
      "type": "enum",
      "values": [
        "NOT_STARTED",
        "PENDING",
        "SUCCESS",
        "FAILED"
      ],
      "default": "NOT_STARTED"
    },
    "Inventory.available": {
      "type": "bool",
      "default": true
    },
    "Invoice.generated": {
      "type": "bool",
      "default": false
    },
    "Notification.sent": {
      "type": "bool",
      "default": false
    },
    "Profile.updated": {
      "type": "bool",
      "default": false
    },
    "Report.generated": {
      "type": "bool",
      "default": false
    },
    "Music.playing": {
      "type": "bool",
      "default": false
    }
  },
  "capabilities": {
    "CreateOrder": {
      "name": "CreateOrder",
      "capability_type": "FUNCTION",
      "inputs": [
        {
          "name": "cart_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "order_id",
          "data_type": "UUID",
          "domain": "valid UUIDs"
        }
      ],
      "preconditions": [
        {
          "variable": "Cart.exists",
          "operator": "==",
          "value": true
        },
        {
          "variable": "Cart.item_count",
          "operator": ">",
          "value": 0
        },
        {
          "variable": "Cart.locked",
          "operator": "==",
          "value": false
        }
      ],
      "effects": [
        {
          "variable": "Order.exists",
          "value": true,
          "operation": "SET"
        },
        {
          "variable": "Order.status",
          "value": "CREATED",
          "operation": "SET"
        },
        {
          "variable": "Cart.locked",
          "value": true,
          "operation": "SET"
        }
      ],
      "constraints": [
        {
          "name": "cart_has_items",
          "expression": "Cart.item_count > 0",
          "constraint_type": "input"
        }
      ],
      "resources": [
        {
          "name": "Database",
          "resource_type": "system",
          "quantity": 1.0
        }
      ],
      "quality": {
        "monetary_cost": 0.01,
        "execution_time_ms": 80.0,
        "resource_cost": 2.0,
        "risk": 0.05,
        "energy_cost": 0.01
      },
      "reliability": 0.99,
      "availability": 1.0,
      "mechanism": {
        "mechanism_type": "FUNCTION_CALL",
        "endpoint_or_target": "create_order_function",
        "protocol_or_action": "EXECUTE",
        "details": {}
      },
      "description": "Creates an order from an active unlocked cart with items.",
      "is_composite": false
    },
    "MakePayment": {
      "name": "MakePayment",
      "capability_type": "API",
      "inputs": [
        {
          "name": "order_id",
          "data_type": "UUID",
          "domain": "valid UUIDs",
          "required": true
