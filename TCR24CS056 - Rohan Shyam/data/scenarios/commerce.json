{
  "id": "commerce-checkout",
  "name": "Commerce checkout capability scenario",
  "states": [
    {"id": "initial", "values": {"Cart.exists": true, "Cart.item_count": 2, "Cart.locked": false, "Order.exists": false, "Payment.status": "NOT_STARTED", "Notification.sent": false}},
    {"id": "order-created", "values": {"Cart.exists": true, "Cart.item_count": 2, "Cart.locked": true, "Order.exists": true, "Order.status": "CREATED", "Payment.status": "NOT_STARTED", "Notification.sent": false}}
  ],
  "goals": [
    {"id": "complete-purchase", "conditions": [{"name": "Order.exists", "value": true}, {"name": "Payment.status", "value": "SUCCESS"}, {"name": "Notification.sent", "value": true}]}
  ],
  "capabilities": [
    {"id": "create-order-api", "name": "CreateOrder API", "type": "API", "mechanism": {"method": "POST", "endpoint": "/orders"}, "inputs": [{"name": "cart_id", "type": "UUID", "domain": "valid UUIDs"}], "outputs": [{"name": "order_id", "type": "UUID", "domain": "valid UUIDs"}], "preconditions": [{"name": "Cart.exists", "value": true}, {"name": "Cart.item_count", "operator": ">", "value": 0}], "effects": [{"name": "Order.exists", "value": true}, {"name": "Order.status", "value": "CREATED"}], "constraints": [{"name": "Cart.locked", "operator": "=", "value": false}], "resources": ["database", "network"], "cost": {"time_ms": 120, "money": 0.01, "resource": 1, "risk": 0.02, "energy": 0.2}, "reliability": 0.99, "availability": 0.98},
    {"id": "make-payment", "name": "MakePayment", "type": "SERVICE", "mechanism": {"provider": "payment-gateway"}, "inputs": [{"name": "order_id", "type": "UUID", "domain": "valid UUIDs"}], "outputs": [{"name": "payment_id", "type": "UUID"}], "preconditions": [{"name": "Order.exists", "value": true}], "effects": [{"name": "Payment.status", "value": "SUCCESS"}], "resources": ["payment-gateway", "network"], "cost": {"time_ms": 800, "money": 0.3, "resource": 1, "risk": 0.08, "energy": 0.4}, "reliability": 0.97, "availability": 0.96},
    {"id": "send-receipt", "name": "SendReceipt", "type": "EVENT", "mechanism": {"trigger": "PaymentSucceeded", "handler": "ReceiptNotifier"}, "inputs": [{"name": "payment_id", "type": "UUID"}], "outputs": [], "preconditions": [{"name": "Payment.status", "value": "SUCCESS"}], "effects": [{"name": "Notification.sent", "value": true}], "resources": ["message-queue"], "cost": {"time_ms": 40, "money": 0, "resource": 0.2, "risk": 0.01, "energy": 0.1}, "reliability": 0.995, "availability": 0.999},
    {"id": "create-order-db", "name": "CreateOrder database implementation", "type": "DATABASE", "mechanism": {"operation": "INSERT", "table": "orders"}, "inputs": [{"name": "cart_id", "type": "UUID"}], "outputs": [{"name": "order_id", "type": "UUID"}], "preconditions": [{"name": "Cart.exists", "value": true}], "effects": [{"name": "Order.exists", "value": true}, {"name": "Order.status", "value": "CREATED"}], "resources": ["database"], "cost": {"time_ms": 80, "money": 0, "resource": 1, "risk": 0.03, "energy": 0.1}, "reliability": 0.995, "availability": 0.999},
    {"id": "create-order-gui", "name": "CreateOrder GUI implementation", "type": "GUI", "mechanism": {"action": "CLICK", "component": "submit_order_button"}, "inputs": [{"name": "cart_id", "type": "UUID"}], "outputs": [{"name": "order_id", "type": "UUID"}], "preconditions": [{"name": "Cart.exists", "value": true}], "effects": [{"name": "Order.exists", "value": true}, {"name": "Order.status", "value": "CREATED"}], "resources": ["browser", "network"], "cost": {"time_ms": 1400, "money": 0, "resource": 1, "risk": 0.06, "energy": 0.3}, "reliability": 0.94, "availability": 0.9},
    {"id": "cancel-cart", "name": "CancelCart", "type": "FUNCTION", "mechanism": {"function": "cancel_cart"}, "inputs": [], "outputs": [], "preconditions": [{"name": "Order.exists", "value": false}], "effects": [{"name": "Cart.exists", "value": false}], "resources": ["database"], "cost": {"time_ms": 25, "resource": 0.2, "risk": 0.01}, "reliability": 0.999, "availability": 1.0},
    {"id": "refresh-catalog", "name": "RefreshProductCatalog", "type": "COMPUTATION", "mechanism": {"job": "catalog_refresh"}, "inputs": [], "outputs": [{"name": "catalog_version", "type": "integer"}], "preconditions": [], "effects": [{"name": "Catalog.current", "value": true}], "resources": ["cpu", "database"], "cost": {"time_ms": 3500, "resource": 8, "risk": 0.02, "energy": 4}, "reliability": 0.96, "availability": 0.9}
  ]
}
