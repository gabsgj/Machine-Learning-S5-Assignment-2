{
  "id": "level-3-full-chain",
  "name": "Four states, three-step chain",
  "states": [
    { "id": "cart-ready", "values": { "Cart.exists": true, "Cart.item_count": 2, "Order.exists": false, "Payment.status": "NOT_STARTED", "Notification.sent": false } },
    { "id": "order-created", "values": { "Cart.exists": true, "Cart.item_count": 0, "Order.exists": true, "Payment.status": "NOT_STARTED", "Notification.sent": false } },
    { "id": "payment-success", "values": { "Cart.exists": true, "Cart.item_count": 0, "Order.exists": true, "Payment.status": "SUCCESS", "Notification.sent": false } },
    { "id": "receipt-sent", "values": { "Cart.exists": true, "Cart.item_count": 0, "Order.exists": true, "Payment.status": "SUCCESS", "Notification.sent": true } }
  ],
  "goals": [{ "id": "purchase-complete", "conditions": [{ "name": "Order.exists", "value": true }, { "name": "Payment.status", "value": "SUCCESS" }, { "name": "Notification.sent", "value": true }] }],
  "capabilities": [
    {
      "id": "create-order", "name": "CreateOrder", "type": "API",
      "mechanism": { "method": "POST", "endpoint": "/orders" }, "inputs": [], "outputs": [],
      "preconditions": [{ "name": "Cart.exists", "value": true }, { "name": "Cart.item_count", "operator": ">", "value": 0 }],
      "effects": [{ "name": "Order.exists", "value": true }], "constraints": [], "resources": ["database", "network"],
      "cost": { "time_ms": 120, "money": 0.01, "resource": 1, "risk": 0.02, "energy": 0.2 }, "reliability": 0.99, "availability": 0.98, "components": []
    },
    {
      "id": "make-payment", "name": "MakePayment", "type": "SERVICE",
      "mechanism": { "provider": "payment-gateway" }, "inputs": [], "outputs": [],
      "preconditions": [{ "name": "Order.exists", "value": true }, { "name": "Payment.status", "value": "NOT_STARTED" }], "effects": [{ "name": "Payment.status", "value": "SUCCESS" }],
      "constraints": [], "resources": ["payment-gateway", "network"],
      "cost": { "time_ms": 800, "money": 0.3, "resource": 1, "risk": 0.08, "energy": 0.4 }, "reliability": 0.97, "availability": 0.96, "components": []
    },
    {
      "id": "send-receipt", "name": "SendReceipt", "type": "EVENT",
      "mechanism": { "trigger": "PaymentSucceeded", "handler": "ReceiptNotifier" }, "inputs": [], "outputs": [],
      "preconditions": [{ "name": "Payment.status", "value": "SUCCESS" }, { "name": "Notification.sent", "value": false }],
      "effects": [{ "name": "Notification.sent", "value": true }], "constraints": [], "resources": ["message-queue"],
      "cost": { "time_ms": 40, "money": 0, "resource": 0.2, "risk": 0.01, "energy": 0.1 }, "reliability": 0.995, "availability": 0.999, "components": []
    }
  ]
}
