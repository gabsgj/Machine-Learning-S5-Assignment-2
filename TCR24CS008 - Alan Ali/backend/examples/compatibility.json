{
  "producer": {
    "id": "create-order-api",
    "name": "CreateOrder API",
    "type": "API",
    "mechanism": {"method": "POST", "endpoint": "/orders"},
    "inputs": [{"name": "cart_id", "type": "UUID"}],
    "outputs": [{"name": "order_id", "type": "UUID"}],
    "preconditions": [{"name": "Cart.exists", "value": true}],
    "effects": [{"name": "Order.exists", "value": true}],
    "reliability": 0.99,
    "availability": 0.98
  },
  "consumer": {
    "id": "make-payment",
    "name": "MakePayment",
    "type": "SERVICE",
    "mechanism": {"provider": "payment-gateway"},
    "inputs": [{"name": "order_id", "type": "UUID"}],
    "outputs": [{"name": "payment_id", "type": "UUID"}],
    "preconditions": [{"name": "Order.exists", "value": true}],
    "effects": [{"name": "Payment.status", "value": "SUCCESS"}],
    "reliability": 0.97,
    "availability": 0.96
  }
}
